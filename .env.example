# DUBI app build configuration
#
# production = public/backend real users
# staging = isolated backend/test users
VITE_DUBI_APP_ENV=production
VITE_DUBI_API_BASE_URL=https://dubi-backend.onrender.com

# Example staging override:
# VITE_DUBI_APP_ENV=staging
# VITE_DUBI_API_BASE_URL=https://dubi-backend-staging.onrender.com
#
# Staging builds fail unless VITE_DUBI_API_BASE_URL is set explicitly.
